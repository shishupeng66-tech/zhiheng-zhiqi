/node_modules
/.pnp
.pnp.js
package-lock.json
yarn.lock
pnpm-lock.yaml

# testing
/coverage

# next.js
/.next/
/.nextbuild/
/.next-build/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.idea/
# clerk configuration (can include secrets)
/.clerk/

# local SQLite database (企业本地部署数据，禁止提交真实库到 Git)
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-jwal
*.sqlite-wal
*.sqlite-shm

# local uploaded files
/public/uploads/

# local video engine runtime
/engines/moneyprinterturbo/.venv/
/engines/moneyprinterturbo/config.toml
/engines/moneyprinterturbo/storage/
/engines/moneyprinterturbo/**/__pycache__/

# local voice service runtime
/services/voice-service/.venv/
/storage/voice-service/
/services/voice-service/**/__pycache__/

# cursor 
.cursorrules
/memory-bank

# Sentry Config File
.env.sentry-build-plugin
