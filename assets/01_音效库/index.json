  "usageGuide": {
    "notification": "用于：标题出现、重点信息提示、关键词高亮、按钮点击、数据出现",
    "transition": "用于：镜头切换、场景转换、段落过渡、快切节奏",
    "impact": "用于：重磅信息、核心卖点、数据突出、情绪强调、开场冲击",
    "ambient": "用于：营造场景氛围（工厂画面配工厂环境音等），音量建议10-20%",
    "bgm": "用于：视频整体背景音乐，音量建议15-25%，人声出现时建议降到10%"
  },
  "rendererIntegration": {
    "timelineField": "sfxTrack / bgmTrack",
    "assetRefType": "sound_asset",
    "resolver": "SoundAssetResolver",
    "mixer": "AudioMixer (amix + volume + sidechaincompress)"
  }
}
