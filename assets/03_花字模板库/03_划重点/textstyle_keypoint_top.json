  "version": "1.0",
  "status": "provisional",
  "assStyle": {
    "fontName": "Microsoft YaHei",
    "fontSize": 64,
    "primaryColor": "&H00000000",
    "outlineColor": "&H00000000",
    "backColor": "&H00000000",
    "bold": true,
    "borderStyle": 1,
    "outline": 0,
    "shadow": 0,
    "alignment": 5,
    "marginL": 80,
    "marginR": 80,
    "marginV": 480
  },
  "decorations": [
    {
      "type": "graphic",
      "shape": "rounded_rect",
      "position": "behind_text",
      "backgroundColor": "#FBBF24",
      "opacity": 0.9,
      "paddingX": 48,
      "paddingY": 20,
      "cornerRadius": 16
    }
