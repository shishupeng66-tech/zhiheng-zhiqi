{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "npm run build",
  "env": { "DEMO_MODE": "true", "NEXT_PUBLIC_SENTRY_DISABLED": "true" },
  "build": { "env": { "DEMO_MODE": "true", "NEXT_PUBLIC_SENTRY_DISABLED": "true", "NEXT_TELEMETRY_DISABLED": "1" } }
}
